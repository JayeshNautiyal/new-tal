# === PATTERN-BASED REDIRECTS ===

# Old recruitment agency in {city} patterns → new city pages
RedirectMatch 301 ^/employer/recruitment-agenc(?:y|ies)-in-bangalore/?$  /recruitment-agency-bangalore
RedirectMatch 301 ^/employer/recruitment-agenc(?:y|ies)-in-mumbai/?$  /recruitment-agency-mumbai
