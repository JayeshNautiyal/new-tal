# /employer/technology-hiring root paths
RedirectMatch 301 ^/employer/technology-hiring/?$  /engineering-ai-hiring
RedirectMatch 301 ^/employer/technology-hiring/hire-developers-programmers/?$  /engineering-ai-hiring

# /hire/X.html legacy → new /hire/X-india
RedirectMatch 301 ^/hire/ai-engineers(\.html|/?)$  /hire/ai-engineers-india
RedirectMatch 301 ^/hire/data-engineers(\.html|/?)$  /hire/data-engineers-india
RedirectMatch 301 ^/hire/data-scientists(\.html|/?)$  /hire/data-scientists-india
RedirectMatch 301 ^/hire/machine-learning-engineers(\.html|/?)$  /hire/machine-learning-engineers-india
RedirectMatch 301 ^/hire/android-developers(\.html|/?)$  /hire/android-engineers-india
RedirectMatch 301 ^/hire/(sql|java|blockchain|game|laravel|wordpress)-developers(\.html|/?)$  /hire/backend-engineers-india
RedirectMatch 301 ^/hire/?$  /engineering-ai-hiring

# Old case studies
RedirectMatch 301 ^/case-studies/writesonic(\.html|/?)$  /work/writesonic-ai-engineers
RedirectMatch 301 ^/case-studies/(national-basketball-association|nba)(\.html|/?)$  /work/nba-india-team-build
RedirectMatch 301 ^/case-studies/(talhive-khatabook-case-study|khatabook|plotx|avaana|savii|gradiant-india|s4s)(\.html|/?)$  /case-studies
# Strip trailing slash from /case-studies/ → /case-studies (matches ONLY with slash, not bare URL)
RedirectMatch 301 ^/case-studies/$  /case-studies
RedirectMatch 301 ^/case-study/?$  /case-studies

# Canonicalize case study URLs to /work/<slug> (matches the <link rel="canonical">
# Google may have indexed the root-level versions before sitemap was corrected — these 301s consolidate to canonical.
