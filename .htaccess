# Delhi NCR consolidation
RedirectMatch 301 ^/employer/recruitment-agenc(?:y|ies)-in-(delhi|new-delhi|gurgaon|noida|haryana|punjab|chandigarh|uttar-pradesh|bihar|jharkhand|west-bengal|assam|guwahati|jammu-kashmir|himachal-pradesh|uttarakhand|rajasthan|lucknow|calcutta|kolkata|odisha)/?$  /recruitment-agency-delhi-ncr
# Mumbai consolidation
RedirectMatch 301 ^/employer/recruitment-agenc(?:y|ies)-in-(navi-mumbai|maharashtra|gujarat|ahmedabad|vadodara|surat|madhya-pradesh|chhattisgarh)/?$  /recruitment-agency-mumbai
# Hyderabad consolidation
RedirectMatch 301 ^/employer/recruitment-agenc(?:y|ies)-in-(andhra-pradesh|telangana)/?$  /recruitment-agency-hyderabad
# Chennai consolidation
RedirectMatch 301 ^/employer/recruitment-agenc(?:y|ies)-in-(tamil-nadu|karnataka)/?$  /recruitment-agency-chennai

# /india/{city}/ legacy structure
RedirectMatch 301 ^/india/bangalore(\.html|/?)$  /recruitment-agency-bangalore
RedirectMatch 301 ^/india/mumbai(\.html|/?)$  /recruitment-agency-mumbai
RedirectMatch 301 ^/india/pune(\.html|/?)$  /recruitment-agency-pune
