RedirectMatch 301 ^/india/delhi(\.html|/?)$  /recruitment-agency-delhi-ncr
RedirectMatch 301 ^/india/gurgaon(\.html|/?)$  /recruitment-agency-delhi-ncr
RedirectMatch 301 ^/india/navi-mumbai(\.html|/?)$  /recruitment-agency-mumbai
RedirectMatch 301 ^/india/ahmedabad(\.html|/?)$  /recruitment-agency-mumbai
RedirectMatch 301 ^/india/vadodara(\.html|/?)$  /recruitment-agency-mumbai
RedirectMatch 301 ^/india/surat(\.html|/?)$  /recruitment-agency-mumbai
RedirectMatch 301 ^/india/lucknow(\.html|/?)$  /recruitment-agency-delhi-ncr
RedirectMatch 301 ^/india/(tamil-nadu|karnataka|chennai)(\.html|/?)$  /recruitment-agency-chennai
RedirectMatch 301 ^/india/(andhra-pradesh|telangana)(\.html|/?)$  /recruitment-agency-hyderabad
RedirectMatch 301 ^/india/(maharashtra|gujarat|madhya-pradesh|chhattisgarh)(\.html|/?)$  /recruitment-agency-mumbai
