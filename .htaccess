# Talhive .htaccess — 2026-05-22 (v5)
# 100 standalone HTML files + 378 legacy URL redirects
# Pretty URLs without .html extension

DirectoryIndex index.html
RewriteEngine On

# ── Canonical host: 301 non-www -> www, and http -> https (avoids duplicate 200 hosts) ──
RewriteCond %{HTTP_HOST} !^www\.talhive\.com$ [NC]
RewriteRule ^ https://www.talhive.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://www.talhive.com%{REQUEST_URI} [L,R=301]


# ╔══════════════════════════════════════════════════════════════════╗
# ║ STEP 1: 301 REDIRECTS — Legacy URLs from old WordPress site      ║
# ║ MUST come before rewrite rules so old URLs don't try to serve    ║
# ║ as new URLs. Generated 2026-05-22 from GSC URL backup.           ║
# ║ 323 RedirectMatch rules covering 378 unique legacy URLs.         ║
# ╚══════════════════════════════════════════════════════════════════╝

# === HIGH-TRAFFIC INDIVIDUAL REDIRECTS (53 URLs, sorted by clicks) ===

# 4592 clicks: /about-us/ → /about
RedirectMatch 301 ^/about-us/?$  /about

