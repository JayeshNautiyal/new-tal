# 1 legacy URLs → /privacy
RedirectMatch 301 ^/privacy-policy//?$  /privacy

# ============================================================
# Final catchall safety
# ============================================================
RedirectMatch 301 ^/about-us(\.html|/?)$  /about
RedirectMatch 301 ^/contact-us(\.html|/?)$  /contact
RedirectMatch 301 ^/jobs/?$  /
RedirectMatch 301 ^/candidate/?$  /
RedirectMatch 301 ^/for-candidates(\.html|/?)$  /
RedirectMatch 301 ^/thank-you/?$  /
RedirectMatch 301 ^/terms-condition/?$  /
RedirectMatch 301 ^/privacy-policy/?$  /privacy

# ── Hire page canonical enforcement: bare slug → /hire/slug (301) ──────────────
# All hire pages have canonical set to /hire/<slug>. Without these redirects the
# catch-all rewrite below also serves them at /<slug>, creating a duplicate that
# Google flags as "chose different canonical than user". These 301s close that gap.
RedirectMatch 301 ^/devops-sre-engineers-india/?$        /hire/devops-sre-engineers-india
RedirectMatch 301 ^/ai-engineers-india/?$                /hire/ai-engineers-india
RedirectMatch 301 ^/machine-learning-engineers-india/?$  /hire/machine-learning-engineers-india
RedirectMatch 301 ^/data-scientists-india/?$             /hire/data-scientists-india
RedirectMatch 301 ^/data-engineers-india/?$              /hire/data-engineers-india
RedirectMatch 301 ^/backend-engineers-india/?$           /hire/backend-engineers-india
RedirectMatch 301 ^/android-engineers-india/?$           /hire/android-engineers-india
RedirectMatch 301 ^/cybersecurity-engineers-india/?$     /hire/cybersecurity-engineers-india
RedirectMatch 301 ^/founding-engineers-india/?$          /hire/founding-engineers-india
RedirectMatch 301 ^/engineering-managers-india/?$        /hire/engineering-managers-india
RedirectMatch 301 ^/product-managers-india/?$            /hire/product-managers-india
RedirectMatch 301 ^/ai-product-managers-india/?$         /hire/ai-product-managers-india
RedirectMatch 301 ^/product-designers-india/?$           /hire/product-designers-india

# ╔══════════════════════════════════════════════════════════════════╗
# ║ STEP 2: URL REWRITES — Map clean URLs to .html files             ║
# ╚══════════════════════════════════════════════════════════════════╝

# If requested URL is a real file or directory, serve directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Prefix rewrites for internal-link patterns used across the site
RewriteRule ^hire/([^/]+)/?$ $1.html [L]
RewriteRule ^insights/([^/]+)/?$ $1.html [L]
# Retired case study page (removed Sep 2026)
RewriteRule ^work/senior-android-australia/?$ /case-studies [R=301,L]
RewriteRule ^work/founding-engineers-healthtech/?$ /case-studies [R=301,L]
RewriteRule ^work/([^/]+)/?$ $1.html [L]
# Insight pieces are canonical at /insights/<slug>; 301 any /blog/<slug> variant to canonical.
# Renamed blog slugs (executive search terminology update, Sep 2026)
RewriteRule ^blog/retained-vs-contingent-executive-search/?$ /blog/executive-search-vs-contingent-recruitment [R=301,L]
RewriteRule ^blog/tech-talent-matching-platforms-vs-retained-search/?$ /blog/tech-talent-matching-platforms-vs-executive-search [R=301,L]
RewriteRule ^blog/(india-tech-hiring-market-map|india-gcc-hiring-playbook|how-us-companies-hire-in-india|how-european-companies-build-india-teams|engineering-hiring-bangalore-vs-pune-vs-hyderabad|product-hiring-in-india|design-hiring-in-india)/?$ /insights/$1 [R=301,L]
RewriteRule ^blog/([^/]+)\.html$ /blog/$1 [R=301,L]
RewriteRule ^blog/([^/]+)/?$ $1.html [L]
RewriteRule ^authors/([^/]+)/?$ $1-author.html [L]

# /work → /case-studies (alias for compatibility)
RewriteRule ^work/?$ /case-studies [R=301,L]

# Simple clean URL rewrite (/executive-search → executive-search.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ╔══════════════════════════════════════════════════════════════════╗
# ║ STEP 3: PROTECT LEAD DATA FILES                                  ║
# ║ leads.log + .ratelimit.json must never be readable via browser   ║
# ╚══════════════════════════════════════════════════════════════════╝
<Files "leads.log">
    Require all denied
</Files>
<Files ".ratelimit.json">
    Require all denied
</Files>
# Hidden dotfiles (belt + suspenders for the rate-limit file)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# Custom 404
ErrorDocument 404 /404.html

# Security
Options -Indexes
